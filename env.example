# ============================================
# REQUIRED SECRETS - DO NOT COMMIT REAL VALUES
# Store these in GitHub Secrets for production
# ============================================

# MongoDB Configuration (REQUIRED)
# For production: Use GitHub Secrets
MONGODB_ROOT_PASSWORD=your_mongodb_root_password_here
# Note: MONGODB_URL is constructed automatically in docker-compose.prod.yml
# For local dev, you can use:
# MONGODB_URL=mongodb://admin:${MONGODB_ROOT_PASSWORD}@localhost:27888/shopping_list_auth?authSource=admin

# JWT Configuration (REQUIRED)
# Generate a strong secret key (e.g., openssl rand -hex 32)
# For production: Use GitHub Secrets
JWT_SECRET_KEY=your_jwt_secret_key_here

# Admin User Configuration (REQUIRED)
# For production: Use GitHub Secrets
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# ============================================
# OPTIONAL CONFIGURATION (with defaults)
# ============================================

# Application Configuration
S3_BUCKET=shopping-list-backup
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Port Configuration
BACKEND_PORT=8185
FRONTEND_PORT=3135
MONGODB_PORT=27888

# Docker Hub Configuration (REQUIRED for production)
# For production: Use GitHub Secrets
DOCKER_HUB_USERNAME=your_dockerhub_username
IMAGE_TAG=latest

# Frontend API URL (for production)
NEXT_PUBLIC_API_URL=https://shopping.botpast.com/api